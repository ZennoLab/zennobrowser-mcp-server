  "paths": {
    "/v1/presets/extensions": {
      "get": {
        "tags": [
          "Extension"
        ],
        "summary": "Retrieves extensions accessible to the current user.",
        "operationId": "Get extensions list",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "query",
            "description": "Workspace ID. Use -1 for the default workspace",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": -1
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Starting index for pagination",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "total",
            "in": "query",
            "description": "Maximum number of results to return",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1000
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "Optional extension ID filter",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Optional extension name filter",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "presetId",
            "in": "query",
            "description": "Optional extension preset ID filter",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/GetExtensionsResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetExtensionsResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetExtensionsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
