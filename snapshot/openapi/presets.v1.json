  "components": {
    "schemas": {
      "ErrorResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Extension": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "presetId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "extensionWebId": {
            "type": "string",
            "nullable": true
          },
          "extensionWebUrl": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "enum": [
              "Success",
              "Uploading",
              "Failed"
            ],
            "type": "string"
          },
          "source": {
            "enum": [
              "WebStore",
              "FileStore"
            ],
            "type": "string"
          },
          "version": {
            "$ref": "#/components/schemas/Version"
          }
        },
        "additionalProperties": false
