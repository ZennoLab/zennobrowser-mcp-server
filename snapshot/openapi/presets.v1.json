              "$ref": "#/components/schemas/Extension"
            },
            "nullable": true
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "GetPresetsResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Preset"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
