    "/v1/proxy_folders": {
      "get": {
        "tags": [
          "ProxyFolders"
        ],
        "summary": "Retrieves a list of proxy folders with filtering, sorting, and pagination options.",
        "description": "This method is used to get the list of proxy folders. It supports filtering, sorting, and pagination in returned results. Optional query parameters can be used to refine the result set. If parameters are not specified, the method returns the first page of proxy folders in the default sorting order.",
        "operationId": "Get proxy folders list",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "query",
            "description": "Workspace identifier. -1 means the default workspace.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": -1
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Index of the first folder to return (zero-based).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "total",
            "in": "query",
            "description": "Maximum number of results to return.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1000
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "Filter by certain folder identifier (optional).",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Filter by folder name (optional).",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "sorting",
            "in": "query",
            "description": "Result sorting condition (optional).",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "location",
            "in": "query",
            "description": "Proxy type filter (Local or Cloud).",
            "schema": {
              "enum": [
                "Local",
                "Cloud"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyFolderList"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyFolderList"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyFolderList"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "ProxyFolders"
        ],
        "summary": "Creates a new proxy folder.",
        "description": "This method creates a new proxy folder. The caller must ensure that the specified workspace ID and location are valid.",
        "operationId": "Create proxy folder",
        "parameters": [
