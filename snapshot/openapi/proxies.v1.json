    "/v1/proxies/delete_bulk": {
      "delete": {
        "tags": [
          "Proxies"
        ],
        "summary": "Deletes multiple proxies in a single operation.",
        "description": "This method sends a bulk delete request to the API to remove the specified proxies. Ensure that the provided proxy IDs are valid and exist in the specified workspace.",
        "operationId": "Delete proxies",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "query",
            "description": "Workspace identifier. -1 means the default workspace.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": -1
            }
          }
        ],
        "requestBody": {
          "description": "The array of UUIDs containing the proxies to be deleted. Must not be null or empty.",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "text/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "application/*+json": {
