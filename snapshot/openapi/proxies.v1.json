  "paths": {
    "/v1/proxies": {
      "get": {
        "tags": [
          "Proxies"
        ],
        "summary": "Retrieves a list of proxies with filtering, sorting, and pagination options.",
        "description": "This method provides functionality for filtering, sorting, and paginating proxies. It can filter results by workspace ID, folder ID, proxy ID, name, and sorting criteria. If parameters are not specified, the response returns the default page of proxies in standard order.",
        "operationId": "Get proxies list",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "query",
            "description": "Workspace identifier. -1 means the default workspace.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": -1
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Starting index for the list of proxies to retrieve.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "total",
            "in": "query",
            "description": "Maximum number of proxies to retrieve.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1000
            }
          },
          {
            "name": "folderId",
            "in": "query",
            "description": "Optional folder ID for filtering proxies. Pass null to ignore this filter.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "Optional proxy ID to filter. Pass null to ignore this filter.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Optional name for filtering proxies. Pass null to ignore this filter.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "sorting",
            "in": "query",
            "description": "Optional sorting string to determine the order of the returned proxies. Pass an empty string for default sorting.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "proxyUri",
            "in": "query",
            "description": "Optional proxy Uri address to filter proxies by. Pass empty string to ignore this filter.",
            "schema": {
              "type": "string",
              "default": ""
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyList"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyList"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyList"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/proxies/create": {
      "post": {
        "tags": [
          "Proxies"
        ],
        "summary": "Adds a new proxy entry using the provided configuration parameters.",
        "description": "This method is used to add a new proxy entry using the provided configuration parameters. It returns the generated unique identifier.",
        "operationId": "Create proxy",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "Name of the added proxy. This value cannot be null or empty.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "proxyUri",
            "in": "query",
            "description": "URL-address of the proxy. Must be a valid URL (e.g., http://login:pass@host:port).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workspaceId",
            "in": "query",
            "description": "Workspace identifier. -1 means the default workspace.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": -1
            }
          },
          {
            "name": "folderId",
            "in": "query",
            "description": "Identifier of the folder to associate with the proxy (optional). Defaults to null.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ipChangeUrl",
            "in": "query",
            "description": "URL to trigger IP change for the proxy (optional). Defaults to empty.",
            "schema": {
              "type": "string",
              "default": ""
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/proxies/create_bulk": {
      "post": {
        "tags": [
          "Proxies"
        ],
        "summary": "Creates multiple proxies in a single operation and returns their unique identifiers.",
        "description": "This method processes an array of proxy data and creates all specified proxies. Errors during creation of individual proxies are ignored.",
        "operationId": "Create proxies",
        "parameters": [
          {
            "name": "workspaceId",
            "in": "query",
            "description": "Workspace identifier. -1 means the default workspace.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": -1
            }
          },
          {
            "name": "folderId",
            "in": "query",
            "description": "Optional folder ID to associate with all created proxies.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Array of proxy data containing URI, name, and optional IP change URL for each proxy.",
