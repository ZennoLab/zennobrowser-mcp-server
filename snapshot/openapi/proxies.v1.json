    "/v1/proxies/{proxyId}/change_ip": {
      "post": {
        "tags": [
          "Proxies"
        ],
        "summary": "Changes the IP address of a mobile proxy by invoking the configured IP change URL.",
        "description": "This endpoint triggers an IP change for the specified mobile proxy. \r\n            The proxy must have a valid IP change URL configured.",
        "operationId": "Change mobile proxy IP",
        "parameters": [
          {
            "name": "proxyId",
            "in": "path",
            "description": "The unique identifier of the proxy for which to change the IP address.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "workspaceId",
            "in": "query",
            "description": "The identifier of the workspace containing the proxy. Defaults to -1 to use default workspace.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": -1
            }
