    "/v1/proxies/{proxyId}": {
      "put": {
        "tags": [
          "Proxies"
        ],
        "summary": "Modifies the configuration of an existing proxy server.",
        "description": "This method modifies configuration of an existing proxy server based on specified parameters. Any parameters set to null will leave the corresponding property of the proxy unchanged.",
        "operationId": "Update proxy",
        "parameters": [
          {
            "name": "proxyId",
            "in": "path",
            "description": "Unique identifier of the proxy (required).",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "workspaceId",
            "in": "query",
            "description": "Workspace identifier. -1 means the default workspace.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": -1
            }
          },
          {
            "name": "folderId",
            "in": "query",
            "description": "New folder for the proxy. Set to empty to leave the current value unchanged.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "New name for the proxy. Set to null to retain the current name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "proxyUri",
            "in": "query",
            "description": "New URL for the proxy. Set to null to retain the current URL.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ipChangeUrl",
            "in": "query",
            "description": "New URL for IP rotation. Set to null to retain the current URL.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Proxies"
        ],
        "summary": "Deletes a proxy from the list by its identifier.",
        "description": "This method deletes a proxy from the list by the specified ID. The proxyId value must match an existing proxy in the specified workspace.",
        "operationId": "Delete proxy",
        "parameters": [
          {
            "name": "proxyId",
            "in": "path",
            "description": "Unique identifier of the proxy to delete (required).",
            "required": true,
            "schema": {
              "type": "string",
